# Tailscale auth key: https://login.tailscale.com/admin/settings/keys
# Must be REUSABLE: every worktree's sidecar signs in with this same key (a one-off key only works once).
# Leave Ephemeral OFF: ephemeral nodes use a monthly minutes quota on the free plan, normal ones don't.
# Each worktree keeps its node identity in a volume, so restarts reuse the same node.
TS_AUTHKEY=

# SSH host of your devbox (from ~/.ssh/config), used by `make sync` / `make remoteUp`
DEVBOX=devbox
